# =============================================================================
# NeuralCraft Studio — Environment Variable Template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Runtime Safety ---
SAMPLE_MODE=true
PORT=8000

# --- Primary Heavy Model (Architect & Developer Agents) ---
PRIMARY_MODEL_NAME=claude-opus-4.6-thinking
PRIMARY_MODEL_BASE_URL=https://api.your-provider.example/v1
PRIMARY_MODEL_API_KEY=your-heavy-model-key

# --- Secondary Fast / Cheap Model (Meterless Markovian Compression) ---
ROUTING_MODEL_NAME=gemini-3.8-flash-fast
ROUTING_MODEL_BASE_URL=https://api.your-provider.example/v1
ROUTING_MODEL_API_KEY=your-fast-model-key

# --- Zetaris SQL ---
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-key-here
